        Lesson(
            id: "L7.8",
            title: "Outside the Key",
            thread: TheoryEar,
            minutes: 20,
            prerequisites: ["L7.7"],
            goal: "Spot guest chords: secondary dominants, borrowed chords, and walking bass lines.",
            practice: "Five minutes a day for a week. Play C–A7–Dm–G7 and C–Fm–C. Listen for the surprise each outside chord brings.",
            steps: [
                Learn(
                    title: "Inviting a cousin to the party",
                    explain: "Songs sometimes borrow a chord from outside the family, like inviting a cousin to the party. One kind is a 7 chord that pulls to a chord other than home. In C, A7 pulls to Dm. E7 pulls to Am. Each one acts like a little 5 chord for its target.",
                    facts: [
                        "A7 → Dm: \"5 of 2.\" E7 → Am: \"5 of 6.\"",
                        "Borrowed from C minor: B♭ (the ♭7) and Fm (the minor 4).",
                        "Write guest chords as numbers too: ♭7, or 5/2.",
                    ],
                    visual: Some(ChordPair("A7", "Dm")),
                    tips: [
                        "A secondary dominant is the 5 chord of the next chord. A7 leads to D minor.",
                        "Borrowed chords come from the minor key with the same root, like Fm in C.",
                    ],
                ),
                Activity(
                    title: "A secondary dominant",
                    instructions: "C, A7, Dm, G. Hear A7 pull to Dm.",
                    activity: StrumAlong(chords: ["C", "A7", "Dm", "G"], beats_per_chord: 4, pattern: OldFaithful, tempos: [70.0, 90.0], repeats: 2),
                ),
                Activity(
                    title: "A borrowed chord",
                    instructions: "C, B♭, F, C. The B♭ is the guest.",
                    activity: StrumAlong(chords: ["C", "Bb", "F", "C"], beats_per_chord: 4, pattern: OldFaithful, tempos: [70.0, 90.0], repeats: 2),
                ),
                Learn(
                    title: "Walking bass",
                    explain: "You can link chords with bass notes that walk down like stairs. C, then C with B in the bass, then Am, then Am with G in the bass, then F. A slash in a chord name shows the bass note: C/B.",
                    visual: Some(Tab([(string: 5, fret: 3), (string: 5, fret: 2), (string: 5, fret: 0), (string: 6, fret: 3), (string: 6, fret: 1, beats: 2.0)])),
                ),
                Check(
                    pass_percent: 75,
                    questions: [
                        (
                            prompt: "Which chord is the guest in C – G – Am – B♭?",
                            choices: ["B♭", "G", "Am"],
                            answer: 0,
                            explain: "C, G, and Am all belong to C major. B♭ comes from outside the key, so it's the guest.",
                        ),
                        (
                            prompt: "In C, where does A7 like to go?",
                            choices: ["Dm", "G", "E"],
                            answer: 0,
                            explain: "A7 is the 5 of D minor, so it pulls toward Dm, just like G7 pulls toward C.",
                        ),
                        (
                            prompt: "What does C/B mean?",
                            choices: ["A C chord with B in the bass", "C, then B", "C minor"],
                            answer: 0,
                            explain: "The note after the slash is the bass note: a C chord with B as the lowest note.",
                        ),
                        (
                            prompt: "Which chord is borrowed from C minor?",
                            choices: ["Fm", "F", "G"],
                            answer: 0,
                            explain: "C minor's 4 chord is F minor. Borrowing it into C major gives that bittersweet sound.",
                        ),
                    ],
                ),
            ],
        ),
        Lesson(
            id: "L7.9",
            title: "Figuring Out Songs by Ear",
            thread: TheoryEar,
            minutes: 20,
            prerequisites: ["L7.8"],
            goal: "Find a song's key and chords by ear.",
            practice: "Ten minutes a day for a week. Pick one song you love. Find the home note, then figure out the chords one at a time.",
            steps: [
                Learn(
                    title: "Be a song detective",
                    explain: "Here's how to figure out a song. First, hum the home note and find it on string 6 or 5. That's the key. Next, find the bass notes. Then guess chords from the key's family. Try the 1, 4, 5, and 6 first. Play along to check. Loop the hard parts slowly.",
                    facts: [
                        "Most songs start and end on the 1 chord.",
                        "The 6 chord sounds dark. The 5 chord leans toward home.",
                        "More intervals: a major 6th sounds like \"My Bonnie Lies Over the Ocean.\"",
                    ],
                    visual: Some(NumberWheel(key: "G")),
                ),
                Learn(
                    title: "Step by step",
                    explain: "First, find the home note by humming along. Next, find the bass notes. Those tell you the chord roots. Then decide if each chord sounds happy (major) or sad (minor). Finally, check your guess with the number system.",
                    facts: [
                        "Most songs use the 1, 4, 5, and 6 chords.",
                        "The bass note is usually the chord's root.",
                    ],
                    tips: [
                        "Slow the song down if you can. Work on just a few seconds at a time.",
                    ],
                    visual: Some(NumberWheel(key: "D")),
                ),
                Activity(
                    title: "Cases in G",
                    instructions: "Listen to four chords. Tap their numbers in order.",
                    activity: Detective(key: "G", rounds: 6),
                ),
                Activity(
                    title: "Cases in D",
                    instructions: "Same game, new key.",
                    activity: Detective(key: "D", rounds: 4),
                ),
                Check(
                    pass_percent: 66,
                    questions: [
                        (
                            prompt: "What's the first step to figuring out a song?",
                            choices: ["Find the home note (the key)", "Learn the solo", "Play it fast"],
                            answer: 0,
                            explain: "Find the home note first. Once you know the key, you know which chords to try.",
                        ),
                        (
                            prompt: "Which chords should you try first?",
                            choices: ["The 1, 4, 5, and 6", "The 2 and 3", "Chords outside the key"],
                            answer: 0,
                            explain: "The 1, 4, 5, and 6 chords show up in most songs, so try them first.",
                        ),
                        (
                            prompt: "What should you do with a hard part?",
                            choices: ["Loop it slowly", "Skip it", "Play it faster"],
                            answer: 0,
                            explain: "Loop the hard part slowly until it's clean, then speed it up bit by bit.",
                        ),
                    ],
                ),
            ],
        ),
        Lesson(
            id: "L7.10",
            title: "Expression: Dynamics, Articulation, Phrasing",
            thread: Technique,
            minutes: 15,
            prerequisites: ["L7.9"],
            goal: "Play the same notes soft, loud, and short, and record yourself to listen back.",
            practice: "Five minutes a day for a week. Play a melody three ways: soft, loud, and growing from soft to loud. Record each one.",
            steps: [
                Learn(
                    title: "Read it with feeling",
                    explain: "Playing the right notes is like reading the words right. Expression is reading them with feeling, like an actor. Play some parts soft and some loud. Make some notes short and some smooth. Sing what you play. Then record yourself and listen back.",
                    facts: [
                        "p = soft. f = loud. Change how hard you pick.",
                        "Legato = smooth and connected. Staccato = short and bouncy.",
                        "Phrases are like sentences. Give them a beginning, a middle, and an end.",
                    ],
                    visual: Some(Tab([
                        (string: 2, fret: 0), (string: 2, fret: 1), (string: 2, fret: 3), (string: 1, fret: 0),
                        (string: 1, fret: 1), (string: 1, fret: 0), (string: 2, fret: 3), (string: 2, fret: 1, beats: 2.0),
                    ])),
                ),
                Learn(
                    title: "Musical words",
                    explain: "Music uses Italian words to show feeling. Piano (p) means soft. Forte (f) means loud. Crescendo means get louder little by little. Staccato means short, bouncy notes. Legato means smooth and connected.",
                    facts: [
                        "p = soft, f = loud, mf = medium loud.",
                        "Staccato: a dot over the note. Legato: a curved line.",
                    ],
                    tips: [
                        "Play soft by picking gently near the neck. Play loud by picking firmly near the bridge.",
                    ],
                    visual: Some(Durations),
                ),
                Activity(
                    title: "Three ways",
                    instructions: "Play the passage three times: soft, loud, then short and loud. The mic compares them.",
                    activity: Expression(notes: [
                        (string: 2, fret: 0), (string: 2, fret: 1), (string: 2, fret: 3), (string: 1, fret: 0),
                        (string: 1, fret: 1), (string: 1, fret: 0), (string: 2, fret: 3), (string: 2, fret: 1, beats: 2.0),
                    ]),
                ),
                Activity(
                    title: "Record yourself",
                    instructions: "Record a short solo or song. Listen back. What would you change?",
                    activity: Record(chords: []),
                ),
                Check(
                    pass_percent: 75,
                    questions: [
                        (
                            prompt: "What does \"f\" mean in music?",
                            choices: ["Loud", "Fast", "Finger"],
                            answer: 0,
                            explain: "f stands for forte, the Italian word for loud. p (piano) means soft.",
                        ),
                        (
                            prompt: "What does staccato mean?",
                            choices: ["Short and bouncy", "Smooth and connected", "Very slow"],
                            answer: 0,
                            explain: "Staccato notes are short and bouncy. Legato notes are smooth and connected.",
                        ),
                        (
                            prompt: "What's a great way to hear your own expression?",
                            choices: ["Record yourself and listen back", "Play faster", "Only play loud"],
                            answer: 0,
                            explain: "When you record yourself and listen back, you hear what a listener hears, so it's easy to spot what to change.",
                        ),
                    ],
                ),
            ],
        ),
        Lesson(
            id: "L7.11",
            title: "Write Your Own Song",
            thread: Song,
            minutes: 30,
            prerequisites: ["L7.10"],
            goal: "Build an 8-bar verse and an 8-bar chorus in the Song Builder.",
            practice: "Ten minutes a day for a week. Write a 4-chord verse and a different 4-chord chorus. Hum melodies over them and record your best one.",
            steps: [
                Learn(
                    title: "Start simple",
                    explain: "Pick a key. Then build your song from chord numbers. Make the verse and the chorus feel different. Try a new set of chords, a new strum, or higher notes. Most songs go verse, chorus, verse, chorus, bridge, chorus.",
                    facts: [
                        "Verse: tells the story. Chorus: the big, catchy part.",
                        "Write a melody from the pentatonic or major scale. End phrases on chord tones.",
                        "Use a capo to fit your voice.",
                    ],
                    visual: Some(NumberWheel(key: "G")),
                ),
                Learn(
                    title: "Verse and chorus",
                    explain: "Most songs have a verse and a chorus. The verse tells the story, and the words change each time. The chorus is the big part everyone remembers. It repeats the same words. Make the chorus feel bigger: play louder, strum harder, or sing higher.",
                    facts: [
                        "A simple song: verse, chorus, verse, chorus.",
                        "Try starting the chorus on the 4 chord for a lift.",
                    ],
                    tips: [
                        "Don't wait for a perfect idea. Write something now and fix it later.",
                    ],
                    visual: Some(ChordPair("C", "G")),
                ),
                Activity(
                    title: "Build your song",
                    instructions: "Open the Song Builder, make an 8-bar verse and an 8-bar chorus, and save it.",
                    activity: SongBuilder(verse_bars: 8, chorus_bars: 8),
                ),
                Check(
                    pass_percent: 66,
