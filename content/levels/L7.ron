                            answer: 0,
                            explain: "Change something: the chords, the strum, or how high you play. Contrast makes the chorus stand out.",
                        ),
                        (
                            prompt: "Which is a common song form?",
                            choices: ["Verse, chorus, verse, chorus, bridge, chorus", "Chorus only", "Bridge, bridge, bridge"],
                            answer: 0,
                            explain: "Verse, chorus, verse, chorus, bridge, chorus is one of the most common song forms.",
                        ),
                        (
                            prompt: "What can help a song fit your singing voice?",
                            choices: ["A capo", "A louder strum", "More chords"],
                            answer: 0,
                            explain: "A capo moves every chord up in pitch without new shapes, so you can find the key that fits your voice.",
                        ),
                    ],
                ),
            ],
