            goal: "Play a full song with G, C, and D and down-up strumming.",
            practice: "Ten minutes a day for a week. Play the verse, then the chorus, then the whole song with the app. Try singing along while you strum!",
            steps: [
                Learn(
                    title: "Oh, Susanna",
                    explain: "Oh, Susanna is a famous American folk song from long ago. It uses just three chords: G, C, and D. The verse and the chorus each last eight bars.",
                    facts: [
                        "Verse: G, G, G, D, G, G, D, G.",
                        "Chorus: C, C, G, D, G, G, D, G.",
                        "Bonus: try D7 instead of D at the end of each line to hear the pull back home.",
                    ],
                    visual: Some(ChordPair("G", "D")),
                ),
                Learn(
                    title: "Chords in the song",
                    explain: "Oh, Susanna uses three chords you know: G, C, and D. The verse is mostly G and D, with a quick C. The chorus starts on C, which makes it feel brighter. Practice each change on its own before you play the whole song.",
                    facts: [
                        "G, C, and D are the 1, 4, and 5 chords in the key of G.",
                        "D usually comes right before G, pulling the song home.",
                    ],
                    tips: [
                        "The trickiest switch is C to G. Practice it with one-minute changes.",
                    ],
                    visual: Some(ChordPair("C", "G")),
                ),
                Activity(
