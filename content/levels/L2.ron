            thread: TheoryEar,
            minutes: 12,
            prerequisites: ["L2.8"],
            goal: "Know that one fret is a half step, and find sharps and flats.",
            practice: "Five minutes a day for three days. On string 1, play every fret from 0 to 12 and say each note name, including sharps.",
            steps: [
                Learn(
                    title: "The smallest step",
                    explain: "Each fret is a half step, the smallest step in music. Two frets make a whole step. Between most letters there's a secret note called a sharp or a flat. Sharp means one fret higher. Flat means one fret lower.",
                    facts: [
                        "A♯ and B♭ are the same sound with two names.",
                        "E and F are next-door neighbors. So are B and C. No secret note between them!",
                        "On a piano there's no black key between E and F, or B and C.",
                    ],
                    visual: Some(Piano),
                ),
                Learn(
                    title: "See it on string 1",
                    explain: "On string 1, E to F is a half step: one fret. F to G is a whole step: two frets. The fret in between is F♯, also called G♭.",
                    visual: Some(Neck(notes: [(string: 1, fret: 0), (string: 1, fret: 1), (string: 1, fret: 2), (string: 1, fret: 3)], first_fret: 0, last_fret: 5, show_names: true)),
                ),
                Learn(
                    title: "Sharps and flats",
                    explain: "When two letters are a whole step apart, there's a note in between. It has two names. Going up, it's a sharp: F sharp is one fret above F. Going down, it's a flat: G flat is one fret below G. F sharp and G flat are the very same fret!",
                    facts: [
                        "Sharp (♯) means one fret higher. Flat (♭) means one fret lower.",
                        "There's no sharp between B and C, or between E and F.",
