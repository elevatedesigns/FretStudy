                    instructions: "Down-up eighth notes. One chord per bar.",
                    activity: StrumAlong(chords: ["G", "G", "G", "D", "G", "G", "D", "G"], beats_per_chord: 4, pattern: Eighths, tempos: [70.0, 80.0, 90.0], repeats: 1),
                ),
