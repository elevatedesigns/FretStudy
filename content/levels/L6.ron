        Lesson(
            id: "L6.8",
            title: "Shifting Positions Smoothly",
            thread: Technique,
            minutes: 10,
            prerequisites: ["L6.7"],
            goal: "Move your hand up and down the neck without gaps in the sound.",
            practice: "Three minutes a day for a week. Do the shifting drill with your eyes on the target fret. Then try it with your eyes closed.",
            steps: [
                Learn(
                    title: "Move the whole hand",
                    explain: "A position is the fret your first finger covers. Fifth position means finger 1 is at fret 5. To shift, move your whole arm from the shoulder. Keep your hand in the same shape. Let your thumb ride along the back of the neck with your hand.",
                    facts: [
                        "Positions are often written with Roman numerals. V means 5th position.",
                        "Look ahead to where you're going before you move.",
                    ],
                    visual: Some(Neck(notes: [(string: 1, fret: 1), (string: 1, fret: 4), (string: 1, fret: 5), (string: 1, fret: 8), (string: 1, fret: 9), (string: 1, fret: 12)], first_fret: 0, last_fret: 12, show_names: false)),
                    tips: [
                        "Loosen your grip as you move, then press again when you land.",
                        "Look at where you're going, not where you are.",
                    ],
                ),
                Learn(
                    title: "Use a guide finger",
                    explain: "When you shift, keep one finger lightly touching the string. Slide it along to the new fret. That finger is your guide. It helps your hand land in the right place every time. Then press down when you arrive.",
                    facts: [
                        "Shift on the last note before the new position.",
                        "Your thumb moves with your hand.",
                    ],
                    tips: [
                        "Shift early. If you wait too long, you'll be late for the next note.",
                    ],
                    visual: Some(Tab([(string: 1, fret: 5), (string: 1, fret: 7), (string: 1, fret: 8), (string: 1, fret: 10, tech: Some(Slide)), (string: 1, fret: 12, beats: 2.0)])),
                ),
                Activity(
                    title: "Shifting drill",
                    instructions: "Four notes in each position, then shift. No gaps!",
                    activity: PlayNotes(tempo: 70.0, notes: [
                        (string: 1, fret: 1), (string: 1, fret: 2), (string: 1, fret: 3), (string: 1, fret: 4),
                        (string: 1, fret: 5), (string: 1, fret: 6), (string: 1, fret: 7), (string: 1, fret: 8),
                        (string: 1, fret: 9), (string: 1, fret: 10), (string: 1, fret: 11), (string: 1, fret: 12, beats: 2.0),
                    ]),
                ),
                Check(
                    pass_percent: 66,
                    questions: [
                        (
                            prompt: "What does \"5th position\" mean?",
                            choices: ["Finger 1 covers fret 5", "You play string 5", "Five fingers are down"],
                            answer: 0,
                            explain: "A position is named for the fret your first finger covers. In 5th position, finger 1 is at fret 5.",
                        ),
                        (
                            prompt: "Where should a shift come from?",
                            choices: ["The whole arm, from the shoulder", "Just the fingertips", "The picking hand"],
                            answer: 0,
                            explain: "Move the whole arm from the shoulder and keep the hand's shape. That makes shifts smooth and accurate.",
                        ),
                        (
                            prompt: "What does your thumb do when you shift?",
                            choices: ["It travels along with the hand", "It stays at the nut", "It lets go of the neck"],
                            answer: 0,
                            explain: "The thumb rides along the back of the neck with your hand, so the hand keeps its shape.",
                        ),
                    ],
                ),
            ],
        ),
        Lesson(
            id: "L6.9",
            title: "Sixteenth-Note Strumming and Accents",
            thread: Rhythm,
            minutes: 20,
            prerequisites: ["L6.8"],
            goal: "Strum sixteenth notes with accents and ghost strums.",
            practice: "Five minutes a day for a week. Strum steady sixteenths on E minor at 60 bpm. Then add the funk accents.",
            steps: [
                Learn(
                    title: "Four in every beat",
                    explain: "Now the beat splits into four. Count \"1-e-and-a, 2-e-and-a.\" Your hand moves twice as fast, so keep it loose. Down on the numbers and \"and.\" Up on the \"e\" and \"a.\" Choose which strums are loud and which ones miss the strings. That is the secret of funk and pop grooves.",
                    facts: [
                        "A sixteenth note is one quarter of a beat.",
                        "Accents are louder hits. Ghost strums miss the strings but keep your hand moving.",
                        "Funk players mute the strings with the fretting hand for a scratchy sound.",
                    ],
                    visual: Some(StrumGrid(Sixteenths)),
                    tips: [
                        "Count \"1 e and a, 2 e and a.\" Every syllable is one strum.",
                        "Keep your hand moving even when you skip a strum.",
                    ],
                ),
                Activity(
                    title: "Steady sixteenths",
                    instructions: "Down-up on every slot. Keep your wrist loose.",
                    activity: StrumAlong(chords: ["A-barre", "G-barre"], beats_per_chord: 4, pattern: Sixteenths, tempos: [60.0, 70.0], repeats: 2),
                ),
                Learn(
                    title: "A funk groove",
                    explain: "Here the hand never stops. But only some strums hit the strings. The gray arrows are ghosts. They miss on purpose.",
                    visual: Some(StrumGrid(Funk16)),
                ),
                Activity(
                    title: "Funk it up",
                    instructions: "Play the funk groove on A minor.",
                    activity: StrumAlong(chords: ["Am-barre"], beats_per_chord: 4, pattern: Funk16, tempos: [60.0, 70.0], repeats: 4),
                ),
                Check(
                    pass_percent: 75,
                    questions: [
                        (
                            prompt: "How do you count sixteenth notes?",
                            choices: ["1 e & a, 2 e & a", "1 & 2 &", "1 trip let"],
                            answer: 0,
                            explain: "Each beat splits into four: 1 e & a, 2 e & a.",
                        ),
                        (
                            prompt: "Which way do you strum on the \"e\" and \"a\"?",
                            choices: ["Up", "Down", "You stop"],
                            answer: 0,
                            explain: "With sixteenths, down-strums land on the number and the \"&\", and up-strums land on the \"e\" and \"a\".",
                        ),
                        (
                            prompt: "What is a ghost strum?",
                            choices: ["The hand moves but misses the strings", "A very loud strum", "A strum with no pick"],
                            answer: 0,
                            explain: "A ghost strum keeps the hand swinging but misses the strings. It keeps the groove steady.",
                        ),
                    ],
                ),
            ],
        ),
        Lesson(
            id: "L6.10",
            title: "Fingerstyle Basics: p-i-m-a",
            thread: Technique,
            minutes: 20,
            prerequisites: ["L6.9"],
            goal: "Fingerpick a pattern with your thumb and three fingers.",
            practice: "Five minutes a day for a week. Play p-i-m-a on C, Am, F, and G. Keep your thumb on the bass strings.",
            steps: [
                Learn(
                    title: "Every finger has a lane",
                    explain: "Put the pick down! Each finger on your picking hand gets a job. Your thumb (p) plays the bass strings: 6, 5, and 4. Your index (i) plays string 3. Your middle (m) plays string 2. Your ring finger (a) plays string 1. It's like each finger has its own lane on a track.",
                    facts: [
                        "The letters come from Spanish: pulgar, índice, medio, anular.",
                        "Pick from the big knuckle. Keep your wrist relaxed and your hand still.",
                        "Keep your thumb a little in front of your fingers.",
                        "Go slow! Clean beats fast.",
                    ],
                    visual: Some(StrumGrid(Pima)),
                ),
                Learn(
                    title: "Which string for the thumb?",
                    explain: "Your thumb plays the root of the chord. That's the lowest note with the chord's name. For C and Am, the root is on string 5. For G and E minor, it's on string 6. For D, it's on string 4. Then i, m, and a play strings 3, 2, and 1.",
                    facts: [
                        "p = thumb, i = index, m = middle, a = ring.",
                        "Fingers stay in their lanes: i on 3, m on 2, a on 1.",
                    ],
                    tips: [
                        "Rest your fingers lightly on their strings. That way they always know where to go.",
                    ],
                    visual: Some(ChordPair("C", "Am")),
                ),
                Activity(
                    title: "p-i-m-a on four chords",
                    instructions: "Thumb on the bass, then i-m-a up and m-i back down.",
                    activity: StrumAlong(chords: ["Am", "C", "D", "F"], beats_per_chord: 4, pattern: Pima, tempos: [60.0, 70.0], repeats: 2),
                ),
                Check(
                    pass_percent: 75,
                    questions: [
                        (
                            prompt: "Which strings does the thumb (p) play?",
                            choices: ["The bass strings: 6, 5, and 4", "Only string 1", "Every string"],
                            answer: 0,
                            explain: "The thumb (p) handles the bass strings: 6, 5, and 4.",
                        ),
                        (
                            prompt: "Which finger plays string 2?",
                            choices: ["m (middle)", "i (index)", "a (ring)"],
                            answer: 0,
                            explain: "Each finger has a string: i plays 3, m plays 2, and a plays 1.",
                        ),
                        (
                            prompt: "Which finger plays string 1?",
                            choices: ["a (ring)", "p (thumb)", "m (middle)"],
                            answer: 0,
                            explain: "The ring finger (a) plays string 1, the highest string.",
                        ),
                        (
                            prompt: "Where should the picking motion come from?",
                            choices: ["The big knuckle, with a relaxed hand", "The elbow", "The shoulder"],
                            answer: 0,
                            explain: "Pluck from the big knuckle with a relaxed hand. That gives a clear, even sound without strain.",
                        ),
                    ],
                ),
            ],
        ),
        Lesson(
            id: "L6.11",
            title: "Travis Picking",
            thread: Technique,
            minutes: 20,
            prerequisites: ["L6.10"],
            goal: "Keep a steady alternating thumb while your fingers play between the beats.",
            practice: "Ten minutes a day for two weeks. Travis picking takes time! Play thumb only for three days, then add one finger at a time.",
            steps: [
                Learn(
                    title: "A thumb that never stops",
                    explain: "Your thumb becomes a drummer that never stops. It goes back and forth between two bass strings on every beat. Your fingers sneak notes in between the thumb hits. It sounds like two guitar players at once! This style is named after Merle Travis.",
                    facts: [
                        "For C, the thumb rocks between string 5 and string 4.",
                        "For G, the thumb rocks between string 6 and string 4.",
                        "Learn the thumb by itself first, until it runs on autopilot.",
                    ],
                    visual: Some(StrumGrid(Travis)),
                    tips: [
                        "Your thumb goes back and forth between two bass strings, like a clock ticking.",
                        "If you get lost, stop the fingers and keep the thumb going.",
                    ],
                ),
                Learn(
                    title: "Which bass strings?",
                    explain: "The thumb plays two bass strings, back and forth. For C, it plays string 5 then string 4, and your finger 3 hops to string 6 sometimes. For G and E, the thumb plays string 6 then string 4. For D, it's string 4 then string 3.",
                    facts: [
                        "C: strings 5 and 4.",
                        "G and E: strings 6 and 4. D: strings 4 and 3.",
                    ],
                    tips: [
                        "Rest the side of your hand on the bass strings to make them thump.",
                    ],
                    visual: Some(ChordPair("C", "G")),
                ),
                Activity(
                    title: "Thumb only",
                    instructions: "Play only the bass notes for now: string 5, string 4, string 5, string 4 on C.",
                    activity: PlayNotes(tempo: 70.0, notes: [
                        (string: 5, fret: 3), (string: 4, fret: 2), (string: 5, fret: 3), (string: 4, fret: 2),
                        (string: 5, fret: 3), (string: 4, fret: 2), (string: 5, fret: 3), (string: 4, fret: 2),
                    ]),
                ),
                Activity(
                    title: "Add the fingers",
                    instructions: "Keep the thumb steady. Fingers play on the \"and.\"",
                    activity: StrumAlong(chords: ["C", "G", "Am", "F"], beats_per_chord: 4, pattern: Travis, tempos: [60.0, 70.0], repeats: 2),
                ),
                Check(
                    pass_percent: 75,
                    questions: [
                        (
                            prompt: "In Travis picking, what does the thumb do?",
                            choices: ["Plays every beat, rocking between two bass strings", "Rests on the guitar", "Plays only string 1"],
                            answer: 0,
                            explain: "In Travis picking the thumb plays every beat, rocking between two bass strings, like a steady drummer.",
                        ),
                        (
                            prompt: "When do the fingers play?",
                            choices: ["In between the thumb notes, on the \"and\"", "Only on beat 1", "Never"],
                            answer: 0,
                            explain: "The fingers play between the thumb notes, on the \"and\" of each beat.",
                        ),
                        (
                            prompt: "What should you practice first?",
                            choices: ["The thumb by itself", "The fastest speed", "Only the fingers"],
                            answer: 0,
                            explain: "Practice the thumb alone until it runs by itself. Then the fingers can join without throwing it off.",
                        ),
                    ],
                ),
            ],
        ),
        Lesson(
            id: "L6.12",
            title: "Ear Lab: Recognizing Progressions",
            thread: TheoryEar,
            minutes: 10,
            prerequisites: ["L6.11"],
            goal: "Name common chord progressions by ear.",
            practice: "Five minutes a day for a week. Listen to a song and hum the home note. Then guess if the next chord is the 4 or the 5.",
            steps: [
                Learn(
                    title: "Find home first",
                    explain: "Many songs use the same few chord trips. To name one, first find the home chord. Minor chords, like the 6 chord, sound darker. The 5 chord leans toward home, like it wants to sit down.",
                    facts: [
                        "1–4–5–1: the classic. It sounds like a folk or rock song.",
                        "1–5–6–4: a huge pop progression.",
                        "6–4–1–5: the same chords, but it starts on the dark one.",
                    ],
                    visual: Some(NumberWheel(key: "G")),
                ),
                Learn(
                    title: "What each chord sounds like",
                    explain: "Each number has its own feeling. The 1 chord sounds like home. The 4 chord sounds like leaving home for a trip. The 5 chord sounds like it wants to come back. The 6 chord sounds sad or thoughtful. Learn these feelings and you can name progressions by ear.",
                    facts: [
                        "1: home. 4: going away. 5: wants to go home. 6: a little sad.",
                    ],
                    tips: [
                        "Hum the home note while the music plays. When the chord fights with your hum, it's not the 1.",
                    ],
                    visual: Some(ChordPair("G", "D")),
                ),
                Activity(
                    title: "Name that progression",
                    instructions: "Listen to four chords. Which numbers were they?",
                    activity: EarQuiz(kind: Progressions, rounds: 8),
                ),
                Check(
                    pass_percent: 66,
                    questions: [
                        (
                            prompt: "What should you listen for first?",
                            choices: ["The home chord", "The loudest note", "The fastest strum"],
                            answer: 0,
                            explain: "Find the home chord first. Once you know home, the other chords are easier to name.",
                        ),
                        (
                            prompt: "Which chord in a major key sounds darker?",
                            choices: ["The 6 chord (minor)", "The 1 chord", "The 4 chord"],
                            answer: 0,
                            explain: "The 6 chord is minor, so it sounds darker than the 1, 4, and 5 chords, which are major.",
                        ),
                        (
                            prompt: "In G, what are the chords of 1–5–6–4?",
                            choices: ["G, D, Em, C", "G, C, D, G", "Em, C, G, D"],
                            answer: 0,
                            explain: "In G, the 1 is G, the 5 is D, the 6 is E minor, and the 4 is C.",
                        ),
                    ],
                ),
            ],
        ),
        Lesson(
            id: "L6.13",
            title: "Level 6 Song: Canon in D",
            thread: Song,
            minutes: 25,
            prerequisites: ["L6.12"],
            goal: "Play Pachelbel's Canon in D, strummed and then fingerpicked.",
            practice: "Ten minutes a day for a week. Strum the eight chords along with the music. Then fingerpick them with p-i-m-a.",
            steps: [
                Learn(
                    title: "A very old hit",
                    explain: "Pachelbel wrote this music more than 300 years ago. People still play it at weddings today! It walks through eight chords: D, A, Bm, F♯m, G, D, G, A. In numbers, that's 1-5-6-3-4-1-4-5. You'll need two barre chords: Bm and F♯m.",
                    facts: [
                        "Bm is an A-shape minor barre at fret 2.",
                        "F♯m is an E-shape minor barre at fret 2.",
                        "Level 1: strum it. Level 2: fingerpick it.",
                    ],
                    visual: Some(ChordPair("Bm", "F#m")),
                ),
                Learn(
                    title: "The eight-chord pattern",
                    explain: "Canon in D uses eight chords: D, A, Bm, F sharp minor, G, D, G, A. Then it repeats again and again. Learn it in two halves. The first half is D, A, Bm, F sharp minor. The second half is G, D, G, A.",
                    facts: [
                        "In numbers: 1, 5, 6, 3, 4, 1, 4, 5.",
                        "Each chord gets two beats in our version.",
                    ],
                    tips: [
                        "The bass note walks down step by step. Listen for it!",
                    ],
                    visual: Some(ChordPair("D", "A")),
                ),
                Activity(
                    title: "Strum check",
                    instructions: "Check the two barre chords first.",
                    activity: ChordCheck(chords: ["Bm", "F#m"]),
                ),
                Activity(
                    title: "Level 1: strummed",
                    instructions: "Two beats per chord. Keep it gentle.",
                    activity: StrumAlong(chords: ["D", "A", "Bm", "F#m", "G", "D", "G", "A"], beats_per_chord: 2, pattern: Eighths, tempos: [60.0, 70.0], repeats: 2),
