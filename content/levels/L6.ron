// Level 6 — The Whole Neck. See docs/02-Curriculum-Part3-Levels-5-6.md.
Level(
    number: 6,
    title: "The Whole Neck",
    goal: "All five pentatonic shapes, major pentatonic, CAGED, triads, 16th-note strumming, and fingerpicking.",
    weeks: "8–10 weeks",
    lessons: [
        Lesson(
            id: "L6.1",
            title: "Relative Minor: Same Notes, Different Home",
            thread: TheoryEar,
            minutes: 12,
            prerequisites: ["L5.13"],
            goal: "Find the relative minor of any major key.",
            practice: "Five minutes a day for a week. Play C, F, G, then Am, Dm, Em. Notice how the same chords sound brighter or darker depending on where you start and end.",
            steps: [
                Learn(
                    title: "Two houses, same furniture",
                    explain: "C major and A minor use the exact same seven notes. They are like two houses with the same furniture but a different front door. In C major, C feels like home. In A minor, A feels like home. Every major key has a minor key that shares its notes. It lives on the 6th note of the scale.",
                    facts: [
                        "Find it fast: count down three frets from the major root.",
                        "C → Am. G → Em. D → Bm. A → F♯m. E → C♯m. F → Dm.",
                        "That's why A minor pentatonic has the same notes as C major pentatonic.",
                    ],
                    visual: Some(NumberWheel(key: "C")),
                ),
                Learn(
                    title: "Count down three frets",
                    explain: "Here's how to find any relative minor. Start on the major key's root and count down three frets. From C, three frets down is A. So A minor is C major's relative minor. From G, three frets down is E. So E minor goes with G major.",
                    facts: [
                        "C major ↔ A minor. G major ↔ E minor.",
                        "D major ↔ B minor. F major ↔ D minor.",
                    ],
                    tips: [
                        "The 6 chord in any major key is its relative minor.",
                    ],
                    visual: Some(Neck(notes: [(string: 5, fret: 0), (string: 5, fret: 3)], first_fret: 0, last_fret: 5, show_names: true)),
                ),
                Activity(
                    title: "Bright or dark?",
                    instructions: "Major chords are bright. Minor chords are darker. Can you tell?",
                    activity: EarQuiz(kind: MajorMinor, rounds: 6),
                ),
                Check(
                    pass_percent: 75,
                    questions: [
                        (
                            prompt: "What is the relative minor of C major?",
                            choices: ["A minor", "E minor", "D minor"],
                            answer: 0,
                            explain: "The relative minor lives on the 6th note of the major scale. Count C D E F G A: the 6th is A, so A minor.",
                        ),
                        (
                            prompt: "What is the relative minor of G major?",
                            choices: ["E minor", "B minor", "A minor"],
                            answer: 0,
                            explain: "Count up G major: G A B C D E. The 6th note is E, so the relative minor is E minor.",
                        ),
                        (
                            prompt: "What is the relative minor of D major?",
                            choices: ["B minor", "F♯ minor", "E minor"],
                            answer: 0,
                            explain: "Count up D major: D E F♯ G A B. The 6th note is B, so the relative minor is B minor.",
                        ),
                        (
                            prompt: "Which note of the major scale is the relative minor's home?",
                            choices: ["The 6th", "The 2nd", "The 5th"],
                            answer: 0,
                            explain: "Start the major scale on its 6th note and you get its relative minor, which uses the very same notes.",
                        ),
                        (
                            prompt: "E minor is the relative minor of which major key?",
                            choices: ["G major", "C major", "E major"],
                            answer: 0,
                            explain: "Go three frets (three half steps) up from E: F, F♯, G. So E minor and G major share all their notes.",
                        ),
                        (
                            prompt: "Do C major and A minor use the same notes?",
                            choices: ["Yes, the same seven notes", "No, they share only one note"],
                            answer: 0,
                            explain: "Yes. A minor is just C major's notes with A as the home note.",
                        ),
                    ],
                ),
            ],
        ),
        Lesson(
            id: "L6.2",
            title: "The Major Pentatonic",
            thread: Notes,
            minutes: 15,
            prerequisites: ["L6.1"],
            goal: "Play the major pentatonic with the box shape you know, and solo over a major-key song.",
            practice: "Five minutes a day for a week. Play the major pentatonic in A and G. Solo over a happy backing track and end on the root.",
            steps: [
                Learn(
                    title: "Same box, sunny sound",
                    explain: "Take the minor box you know. Give it a new home note, and it sounds happy and sunny! That's the major pentatonic. It's the sound of country, pop, and classic rock solos. Same shape, new starting point.",
                    facts: [
                        "The recipe: 1, 2, 3, 5, 6. G major pentatonic is G A B D E.",
                        "Shape trick: play Box 1 three frets lower than the major root.",
                        "A major pentatonic = Box 1 at fret 2. The root A is under your pinky on string 6.",
                        "Use major pentatonic over happy songs. Use minor over sad songs and the blues.",
                    ],
                    visual: Some(ScaleBox(root: "A", scale: "major_pentatonic", shape: Some(1), first_fret: 1, last_fret: 7)),
                ),
                Learn(
                    title: "Slide the box down three frets",
                    explain: "Here's a neat trick. Take the minor pentatonic box and slide it down three frets. Now it's the major pentatonic! For A major, play Box 1 starting at fret 2 instead of fret 5. The shape is the same, but the home note changes.",
                    facts: [
                        "A minor pentatonic: Box 1 at fret 5.",
                        "A major pentatonic: Box 1 at fret 2.",
                    ],
                    tips: [
                        "Land on A to sound sunny and finished. Listen for the happy sound.",
                    ],
                    visual: Some(ScaleCompare(root: "A", a: "major_pentatonic", b: "minor_pentatonic", first_fret: 1, last_fret: 9)),
                ),
                Activity(
                    title: "A major pentatonic",
                    instructions: "Play the box at fret 2. Listen for the happy sound.",
                    activity: PlayNotes(tempo: 60.0, notes: [
                        (string: 6, fret: 2), (string: 6, fret: 5), (string: 5, fret: 2), (string: 5, fret: 4),
                        (string: 4, fret: 2), (string: 4, fret: 4), (string: 3, fret: 2), (string: 3, fret: 4),
                        (string: 2, fret: 2), (string: 2, fret: 5), (string: 1, fret: 2), (string: 1, fret: 5, beats: 2.0),
                    ]),
                ),
                Activity(
                    title: "Solo in G major",
                    instructions: "Play G major pentatonic near the nut over G, C, and D. End your ideas on G.",
                    activity: Jam(key: "G", scale: "major_pentatonic", shape: Some(1), chords: ["G", "C", "D", "G"], pattern: Eighths, bpm: 80.0),
                ),
                Check(
                    pass_percent: 75,
                    questions: [
                        (
                            prompt: "What is the major pentatonic recipe?",
                            choices: ["1, 2, 3, 5, 6", "1, ♭3, 4, 5, ♭7", "1, 3, 5"],
                            answer: 0,
                            explain: "Major pentatonic is the major scale without the 4th and 7th: 1, 2, 3, 5, 6.",
                        ),
                        (
                            prompt: "G major pentatonic has the same notes as…",
                            choices: ["E minor pentatonic", "A minor pentatonic", "G minor pentatonic"],
                            answer: 0,
                            explain: "E is G's relative minor, so E minor pentatonic and G major pentatonic have the same five notes: G A B D E.",
                        ),
                        (
                            prompt: "Where does Box 1 go for A major pentatonic?",
                            choices: ["Fret 2, three frets below A", "Fret 5", "Fret 8"],
                            answer: 0,
                            explain: "A major pentatonic uses the notes of F♯ minor pentatonic. F♯ is three frets below A, at fret 2 on string 6.",
                        ),
                        (
                            prompt: "Which scale fits a happy, major-key song best?",
                            choices: ["Major pentatonic", "Minor pentatonic", "The blues scale"],
                            answer: 0,
                            explain: "Major pentatonic has the major 3rd, so it sounds sunny and fits happy, major-key songs.",
                        ),
                    ],
                ),
            ],
        ),
        Lesson(
            id: "L6.3",
            title: "Pentatonic Shapes 2 and 3",
            thread: Notes,
            minutes: 20,
            prerequisites: ["L6.2"],
            goal: "Play A minor pentatonic shapes 2 and 3, and slide between boxes.",
            practice: "Five minutes a day for a week. Play Box 1, then Box 2, then Box 3. Each day, slide from one box to the next without stopping.",
            steps: [
                Learn(
                    title: "Puzzle pieces up the neck",
                    explain: "The scale doesn't stop at Box 1. Its notes keep going up the neck in five shapes. They link like puzzle pieces. The right side of one box is the left side of the next. Shape 2 starts where Box 1's top notes are.",
                    facts: [
                        "Shape 2 in A sits at frets 7 to 10.",
                        "Its low note on string 6 is C, at fret 8.",
                        "Slide to move from one box to the next.",
                    ],
                    visual: Some(ScaleBox(root: "A", scale: "minor_pentatonic", shape: Some(2), first_fret: 4, last_fret: 12)),
                    tips: [
                        "The top notes of one box are the bottom notes of the next. Use them as stepping stones.",
                        "Learn one box well before adding the next.",
                    ],
                ),
                Activity(
                    title: "Shape 2",
                    instructions: "Up shape 2 from string 6.",
                    activity: PlayNotes(tempo: 60.0, notes: [
                        (string: 6, fret: 8), (string: 6, fret: 10), (string: 5, fret: 7), (string: 5, fret: 10),
                        (string: 4, fret: 7), (string: 4, fret: 10), (string: 3, fret: 7), (string: 3, fret: 9),
                        (string: 2, fret: 8), (string: 2, fret: 10), (string: 1, fret: 8), (string: 1, fret: 10, beats: 2.0),
                    ]),
                ),
                Learn(
                    title: "Shape 3",
                    explain: "Shape 3 is the next piece. It sits at frets 9 to 13. Its low note on string 6 is D, at fret 10. Notice the dots it shares with shape 2.",
                    visual: Some(ScaleBox(root: "A", scale: "minor_pentatonic", shape: Some(3), first_fret: 7, last_fret: 14)),
                ),
                Activity(
                    title: "Shape 3",
                    instructions: "Up shape 3 from string 6.",
                    activity: PlayNotes(tempo: 60.0, notes: [
                        (string: 6, fret: 10), (string: 6, fret: 12), (string: 5, fret: 10), (string: 5, fret: 12),
                        (string: 4, fret: 10), (string: 4, fret: 12), (string: 3, fret: 9), (string: 3, fret: 12),
                        (string: 2, fret: 10), (string: 2, fret: 13), (string: 1, fret: 10), (string: 1, fret: 12, beats: 2.0),
                    ]),
                ),
                Activity(
                    title: "Slide from box to box",
                    instructions: "Play in Box 1, slide up into shape 2, then into shape 3.",
                    activity: PlayNotes(tempo: 60.0, notes: [
                        (string: 3, fret: 5), (string: 3, fret: 7), (string: 3, fret: 9, tech: Some(Slide)), (string: 2, fret: 10),
                        (string: 2, fret: 13, tech: Some(Slide)), (string: 1, fret: 12, beats: 2.0),
                    ]),
                ),
                Check(
                    pass_percent: 66,
                    questions: [
                        (
                            prompt: "How do the five shapes fit together?",
                            choices: ["Like puzzle pieces that share notes", "They don't touch at all", "They all sit at the same fret"],
                            answer: 0,
                            explain: "The top notes of one shape are the bottom notes of the next, so they lock together like puzzle pieces.",
                        ),
                        (
                            prompt: "In A, what note starts shape 2 on string 6?",
                            choices: ["C (fret 8)", "A (fret 5)", "E (fret 12)"],
                            answer: 0,
                            explain: "Shape 2 starts on the scale's next note after A, which is C. On string 6, C is at fret 8.",
                        ),
                        (
                            prompt: "What helps you move from one box to the next?",
                            choices: ["A slide", "A bend", "A capo"],
                            answer: 0,
                            explain: "A slide carries your finger up the string into the next box without stopping the sound.",
                        ),
                    ],
                ),
            ],
        ),
        Lesson(
            id: "L6.4",
            title: "Pentatonic Shapes 4 and 5: The Whole Neck",
            thread: Notes,
            minutes: 20,
            prerequisites: ["L6.3"],
            goal: "Play shapes 4 and 5 and see the whole neck as one scale.",
            practice: "Five minutes a day for two weeks. Play all five boxes in order up the neck. Then try a solo that uses two boxes.",
            steps: [
                Learn(
                    title: "Shape 4",
                    explain: "Shape 4 sits at frets 12 to 15. Its low note on string 6 is E, at fret 12. That is the same E as your open string, just higher.",
                    visual: Some(ScaleBox(root: "A", scale: "minor_pentatonic", shape: Some(4), first_fret: 10, last_fret: 17)),
                ),
                Activity(
                    title: "Shape 4",
                    instructions: "Up shape 4 from string 6.",
                    activity: PlayNotes(tempo: 60.0, notes: [
                        (string: 6, fret: 12), (string: 6, fret: 15), (string: 5, fret: 12), (string: 5, fret: 15),
                        (string: 4, fret: 12), (string: 4, fret: 14), (string: 3, fret: 12), (string: 3, fret: 14),
                        (string: 2, fret: 13), (string: 2, fret: 15), (string: 1, fret: 12), (string: 1, fret: 15, beats: 2.0),
                    ]),
                ),
                Learn(
                    title: "Shape 5, low and high",
                    explain: "Shape 5 sits at frets 15 to 17. It also lives down low, at frets 2 to 5. After shape 5 comes Box 1 again, one octave up. Now you have the whole neck!",
                    facts: [
                        "Low shape 5 starts on G, at string 6, fret 3.",
                        "To play in another key, slide the whole map so the roots land on the new key.",
                    ],
                    visual: Some(ScaleBox(root: "A", scale: "minor_pentatonic", shape: Some(5), first_fret: 0, last_fret: 7)),
                ),
                Activity(
                    title: "Low shape 5",
                    instructions: "Up shape 5 near the nut.",
                    activity: PlayNotes(tempo: 60.0, notes: [
                        (string: 6, fret: 3), (string: 6, fret: 5), (string: 5, fret: 3), (string: 5, fret: 5),
                        (string: 4, fret: 2), (string: 4, fret: 5), (string: 3, fret: 2), (string: 3, fret: 5),
                        (string: 2, fret: 3), (string: 2, fret: 5), (string: 1, fret: 3), (string: 1, fret: 5, beats: 2.0),
                    ]),
                ),
                Learn(
                    title: "The whole map",
                    explain: "Here is A minor pentatonic over the whole neck. Every red square is an A. Find the five shapes hiding in the map.",
                    visual: Some(ScaleBox(root: "A", scale: "minor_pentatonic", first_fret: 0, last_fret: 17)),
                    tips: [
                        "After fret 12, the boxes repeat. Box 1 at fret 17 is the same as Box 1 at fret 5.",
                        "Find the root notes in each box first. They tie the whole map together.",
                    ],
                ),
                Check(
                    pass_percent: 66,
                    questions: [
                        (
                            prompt: "What comes after shape 5, going up?",
                            choices: ["Box 1 again, an octave higher", "Shape 6", "The end of the scale"],
                            answer: 0,
                            explain: "The five shapes repeat. After shape 5 comes Box 1 again, twelve frets (an octave) higher.",
                        ),
                        (
                            prompt: "How many pentatonic shapes are there?",
                            choices: ["5", "3", "7"],
                            answer: 0,
                            explain: "There are five shapes, one starting on each of the scale's five notes.",
                        ),
                        (
                            prompt: "How do you play the shapes in a new key?",
                            choices: ["Slide the whole map so the roots land on the new key", "Learn all new shapes", "Use only open strings"],
                            answer: 0,
                            explain: "The shapes don't change. Slide the whole pattern until its roots sit on the new key's note.",
                        ),
                    ],
                ),
            ],
        ),
        Lesson(
            id: "L6.5",
            title: "The CAGED System",
            thread: Chords,
            minutes: 25,
            prerequisites: ["L6.4"],
            goal: "Play one major chord in five places using the C, A, G, E, and D shapes.",
            practice: "Five minutes a day for a week. Play C in all five CAGED shapes, from low to high. Then try G.",
            steps: [
                Learn(
                    title: "Five shapes, one chord",
                    explain: "You already know five open chord shapes: C, A, G, E, and D. Here's the big secret. Each one can move up the neck. And they line up in that order, C-A-G-E-D, to make one chord in five places. Learn this and the neck stops being a mystery.",
                    facts: [
                        "C major: C shape (open), A shape (fret 3), G shape (frets 5–8), E shape (fret 8), D shape (fret 10).",
                        "Then the C shape comes back at fret 12.",
                        "Click a shape to light it up and hear it.",
                    ],
                    visual: Some(Caged(root: "C")),
                ),
                Learn(
                    title: "Same order, any key",
                    explain: "The order always stays C-A-G-E-D. Only the first shape changes. For G major, start with the E shape at fret 3. Then come the D, C, A, and G shapes.",
                    visual: Some(Caged(root: "G")),
                ),
                Learn(
                    title: "Find the root in each shape",
                    explain: "Every CAGED shape has a root note you already know. In the C shape, it's on string 5. In the A shape, it's also on string 5. In the G and E shapes, it's on string 6. In the D shape, it's on string 4. Find the root first, then build the shape around it.",
                    facts: [
                        "C and A shapes: root on string 5.",
                        "G and E shapes: root on string 6. D shape: root on string 4.",
                    ],
                    tips: [
                        "You don't have to play the full shape. Grab three or four strings and it still works.",
                    ],
                    visual: Some(Neck(notes: [(string: 5, fret: 3), (string: 6, fret: 8), (string: 4, fret: 10), (string: 5, fret: 15)], first_fret: 0, last_fret: 15, show_names: true)),
                ),
                Activity(
                    title: "C in five places",
                    instructions: "Play C major in each shape, low to high. Tick each one.",
                    activity: Checklist(items: [
                        "C shape (open C)",
                        "A shape (barre at fret 3)",
                        "G shape (frets 5 to 8, top strings are fine)",
                        "E shape (barre at fret 8)",
                        "D shape (top strings, frets 10 to 13)",
                    ]),
                ),
                Activity(
                    title: "Strum check",
                    instructions: "Strum the A-shape and E-shape C chords.",
                    activity: ChordCheck(chords: ["C", "C-Abarre", "C-barre"]),
                ),
                Check(
                    pass_percent: 75,
                    questions: [
                        (
                            prompt: "What is the order of the CAGED shapes up the neck?",
                            choices: ["C, A, G, E, D", "A, B, C, D, E", "E, A, D, G, C"],
                            answer: 0,
                            explain: "Up the neck, the open-chord shapes line up in the order C, A, G, E, D, then start again.",
                        ),
                        (
                            prompt: "After the D shape, which shape comes next?",
                            choices: ["C again", "E again", "None"],
                            answer: 0,
                            explain: "The order is a loop. After the D shape comes the C shape again, an octave higher.",
                        ),
                        (
                            prompt: "An E-shape barre at fret 5 is which chord?",
                            choices: ["A major", "E major", "C major"],
                            answer: 0,
                            explain: "String 6, fret 5 is A.",
                        ),
                        (
                            prompt: "For G major, which shape is at fret 3?",
                            choices: ["The E shape", "The C shape", "The D shape"],
                            answer: 0,
                            explain: "G is at fret 3 on string 6, and the E shape has its root on string 6. So the E shape sits at fret 3.",
                        ),
                    ],
                ),
            ],
        ),
        Lesson(
            id: "L6.6",
            title: "Triads and Inversions",
            thread: Chords,
            minutes: 20,
            prerequisites: ["L6.5"],
            goal: "Play major triads on the top three strings and name their inversions.",
            practice: "Five minutes a day for a week. Play C, F, and G as triads on strings 3-2-1 in all three positions. Use the Chords screen's Inversions tab to check.",
            steps: [
                Learn(
                    title: "The smallest real chord",
                    explain: "A triad is the smallest real chord. It has just three notes: the root, the 3rd, and the 5th. You can stack them in any order. Root on the bottom, 3rd on the bottom, or 5th on the bottom. Each order is called an inversion. On the top three strings, triads make bright little chords.",
                    facts: [
                        "Root position: the root is on the bottom.",
                        "1st inversion: the 3rd is on the bottom.",
                        "2nd inversion: the 5th is on the bottom.",
                    ],
                    visual: Some(Shape(frets: "xxx553", fingers: "---341", name: "C triad, root position (C E G)")),
                ),
                Learn(
                    title: "C up the neck",
                    explain: "Here are the other two orders of C. The notes are the same, just stacked in a new way. The 1st inversion has E on the bottom. The 2nd inversion has G on the bottom.",
                    facts: [
                        "1st inversion (E G C): string 3 fret 9, string 2 fret 8, string 1 fret 8.",
                        "2nd inversion (G C E): open G, string 2 fret 1, open E.",
                        "Writing C/E means a C chord with E on the bottom.",
                    ],
                    visual: Some(Shape(frets: "xxx988", fingers: "---311", name: "C triad, 1st inversion (E G C)")),
                ),
                Learn(
                    title: "Three ways to stack C",
                    explain: "A triad has three notes, so it can be stacked three ways. Root position has C on the bottom. First inversion has E on the bottom. Second inversion has G on the bottom. All three are still C major. They just sound a little higher or lower.",
                    facts: [
                        "Root position: C E G.",
                        "1st inversion: E G C. 2nd inversion: G C E.",
                    ],
                    tips: [
                        "Look at the Chords screen. Pick any chord and open the Inversions tab to see all of them.",
                    ],
                    visual: Some(Shape(frets: "xxx010", fingers: "----1-", name: "C triad, 2nd inversion (G C E)")),
                ),
                Activity(
                    title: "Strum check",
                    instructions: "Strum just the top three strings for each triad.",
                    activity: ChordCheck(chords: ["C-tri", "F-tri", "G-tri"]),
                ),
                Activity(
                    title: "C, F, G with triads",
                    instructions: "Stay near frets 5 to 8. Your hand barely moves!",
                    activity: StrumAlong(chords: ["C-tri", "F-tri", "G-tri", "C-tri"], beats_per_chord: 4, pattern: Eighths, tempos: [70.0, 90.0], repeats: 2),
                ),
                Check(
                    pass_percent: 75,
                    questions: [
                        (
                            prompt: "How many notes are in a triad?",
                            choices: ["3", "4", "5"],
                            answer: 0,
                            explain: "A triad has three notes: the root, the 3rd, and the 5th.",
                        ),
                        (
                            prompt: "In a 1st inversion, which note is on the bottom?",
                            choices: ["The 3rd", "The root", "The 5th"],
                            answer: 0,
                            explain: "In 1st inversion, the 3rd moves to the bottom. In 2nd inversion, the 5th is on the bottom.",
                        ),
                        (
                            prompt: "Name this chord.",
                            visual: Some(Shape(frets: "xxx565", fingers: "---121")),
                            choices: ["F", "C", "Am"],
                            answer: 0,
                            explain: "The notes are C (string 3, fret 5), F (string 2, fret 6), and A (string 1, fret 5). C F A makes an F chord.",
                        ),
                        (
                            prompt: "What does C/E mean?",
                            choices: ["A C chord with E on the bottom", "Play C, then E", "C minor"],
                            answer: 0,
                            explain: "The letter after the slash is the bass note. C/E means play a C chord with E as the lowest note.",
                        ),
                    ],
                ),
            ],
        ),
        Lesson(
            id: "L6.7",
            title: "Major Scale Positions",
            thread: Notes,
            minutes: 20,
            prerequisites: ["L6.6"],
            goal: "Play the G major scale in one position and play it in 3rds.",
            practice: "Five minutes a day for a week. Play G major in two octaves, then in 3rds. Say the note names as you go.",
            steps: [
                Learn(
                    title: "The full Do-Re-Mi ladder",
                    explain: "The pentatonic was a ladder with five notes. The major scale is the full ladder with seven notes. It's the Do-Re-Mi one! Here is G major near the nut. Its root sits on string 6, fret 3, inside the E-shape G chord.",
                    facts: [
                        "G major: G A B C D E F♯.",
                        "Finger 1 covers fret 2. Each finger gets its own fret.",
                        "Red squares are G, the root.",
                    ],
                    visual: Some(ScaleBox(root: "G", scale: "major", first_fret: 0, last_fret: 6)),
                    tips: [
                        "Use one finger per fret. Finger 1 plays fret 2, finger 2 fret 3, and so on.",
                        "Start and end on G every time.",
                    ],
                ),
                Activity(
                    title: "G major, two octaves",
                    instructions: "Play the scale from low G to high G.",
                    activity: PlayNotes(tempo: 70.0, notes: [
                        (string: 6, fret: 3), (string: 6, fret: 5), (string: 5, fret: 2), (string: 5, fret: 3), (string: 5, fret: 5),
                        (string: 4, fret: 2), (string: 4, fret: 4), (string: 4, fret: 5), (string: 3, fret: 2), (string: 3, fret: 4),
                        (string: 3, fret: 5), (string: 2, fret: 3), (string: 2, fret: 5), (string: 1, fret: 2), (string: 1, fret: 3, beats: 2.0),
                    ]),
                ),
                Learn(
                    title: "Scales in 3rds",
