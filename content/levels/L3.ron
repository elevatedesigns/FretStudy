        Lesson(
            id: "L3.9",
            title: "Sharps and Flats in First Position",
            thread: Notes,
            minutes: 10,
            prerequisites: ["L3.8", "L2.9"],
            goal: "Find sharps and flats in first position.",
            practice: "Five minutes a day for three days. Pick a string and play every fret from 0 to 4, naming each note with its sharp name going up and its flat name coming down.",
            steps: [
                Learn(
                    title: "One fret up, one fret down",
                    explain: "A sharp is one fret higher. A flat is one fret lower. F♯ is one fret above F. B♭ is one fret below B.",
                    facts: [
                        "F♯ is on string 1 fret 2, string 4 fret 4, and string 6 fret 2.",
                        "To flat an open string, go to the next lower string and play fret 4. The G string is different: its B is at fret 4, so B♭ is at G string fret 3.",
                        "In sheet music, a sharp or flat lasts until the end of the measure.",
                    ],
                    visual: Some(Neck(notes: [(string: 1, fret: 2), (string: 4, fret: 4), (string: 6, fret: 2), (string: 3, fret: 3), (string: 5, fret: 1)], first_fret: 0, last_fret: 5, show_names: true)),
                    tips: [
                        "E and B have no sharp. One fret up from E is F, and one fret up from B is C.",
                    ],
                ),
                Learn(
                    title: "Sharps going up, flats coming down",
                    explain: "Between most natural notes there's one fret. Coming up from F, that fret is called F sharp. Coming down from G, the same fret is called G flat. On string 1, it's fret 2. Find the in-between notes on each string the same way.",
                    facts: [
                        "On string 1: F (1), F♯ or G♭ (2), G (3).",
                        "No in-between note: E to F, and B to C.",
                    ],
                    visual: Some(Neck(notes: [(string: 1, fret: 1), (string: 1, fret: 2), (string: 1, fret: 3), (string: 2, fret: 1), (string: 2, fret: 2), (string: 2, fret: 3)], first_fret: 0, last_fret: 4, show_names: true)),
                ),
                Activity(
                    title: "Note hunt: everywhere",
                    instructions: "Sharps and flats on all six strings, frets 0 to 4.",
                    activity: NoteHunt(strings: [1, 2, 3, 4, 5, 6], max_fret: 4, naturals_only: false, rounds: 8),
                ),
                Check(
                    pass_percent: 75,
                    questions: [
                        (
                            prompt: "Where is F♯ on string 1?",
                            choices: ["Fret 2", "Fret 1", "Fret 3"],
                            answer: 0,
                            explain: "String 1 is E. F is at fret 1, so F sharp (one fret higher) is at fret 2.",
                        ),
                        (
                            prompt: "Where is B♭ on string 3 (the G string)?",
                            choices: ["Fret 3", "Fret 4", "Fret 2"],
                            answer: 0,
                            explain: "String 3 is G. A is at fret 2, so B flat (one fret lower than B, one fret higher than A) is at fret 3.",
                        ),
                        (
                            prompt: "What does a sharp do?",
                            choices: ["Raises a note one fret", "Lowers a note one fret", "Makes it louder"],
                            answer: 0,
                            explain: "A sharp (♯) raises a note by one fret, a half step. A flat (♭) lowers it by one fret.",
                        ),
                        (
                            prompt: "E♭ is one fret below E. Where is it on string 2?",
                            choices: ["Fret 4", "Fret 2", "Fret 1"],
                            answer: 0,
                            explain: "Open-string flat rule: go to the next lower string and play fret 4.",
                        ),
                    ],
                ),
            ],
        ),
        Lesson(
            id: "L3.10",
            title: "Tuning by Ear: The 5th-Fret Method",
            thread: Technique,
            minutes: 12,
            prerequisites: ["L3.8"],
            goal: "Tune the guitar to itself without a tuner.",
            practice: "Tune by ear first, then check with the tuner, every day for a week. Your ears will get faster and more exact.",
            steps: [
                Learn(
                    title: "Strings that match",
                    explain: "If one string is right, it can help tune the others. Press string 6 at fret 5 and you get an A, the same note as open string 5. Make them match! Keep going down the line. There's one trick: the G string uses fret 4 to match the B string.",
                    facts: [
                        "Fret 5 on strings 6, 5, 4, and 2. Fret 4 on string 3.",
                        "Always turn the open string, not the one you're pressing.",
                        "When two notes are almost the same, you hear a slow wah-wah wobble. Tune until it stops.",
                    ],
                    visual: Some(Neck(notes: [(string: 6, fret: 5), (string: 5, fret: 0), (string: 5, fret: 5), (string: 4, fret: 0), (string: 4, fret: 5), (string: 3, fret: 0), (string: 3, fret: 4), (string: 2, fret: 0), (string: 2, fret: 5), (string: 1, fret: 0)], first_fret: 0, last_fret: 7, show_names: true)),
                ),
                Learn(
                    title: "Listen for the wobble",
                    explain: "When two notes are almost the same, you hear a slow wobble, like wah-wah-wah. The closer they get, the slower the wobble. When it stops, the notes match. Turn the peg very slowly and listen for the wobble to fade away.",
                    facts: [
                        "Fast wobble: far apart. Slow wobble: close. No wobble: in tune.",
                        "Let both notes ring together while you turn the peg.",
                    ],
                    tips: [
                        "Tune up to the note, not down. If you pass it, go below and come back up.",
                        "If you can't hear a wobble at all, the string is far off. Use the tuner to get close first.",
                    ],
                    visual: Some(Neck(notes: [(string: 6, fret: 5), (string: 5, fret: 0)], first_fret: 0, last_fret: 7, show_names: true)),
                ),
                Activity(
                    title: "Tune by ear, then check",
                    instructions: "Tune each string to the one below it by ear. Then use the tuner to see how close you got.",
                    activity: Tune,
                ),
                Check(
                    pass_percent: 100,
                    questions: [
                        (
                            prompt: "To tune string 2 (B), you press string 3 at which fret?",
                            choices: ["4", "5", "7"],
                            answer: 0,
                            explain: "The G string at fret 4 plays B. That's the note string 2 should match. (It's the one string that isn't fret 5.)",
                        ),
                        (
                            prompt: "Which string do you turn the peg for?",
                            choices: ["The open string", "The string you're pressing"],
                            answer: 0,
                            explain: "Turn the peg of the open string you're tuning. The pressed string is your reference, so leave it alone.",
                        ),
                    ],
                ),
            ],
        ),
        Lesson(
            id: "L3.11",
            title: "Chord Families and the Magic 1–4–5",
            thread: TheoryEar,
            minutes: 15,
            prerequisites: ["L3.3"],
            goal: "Know that songs use a family of chords, and the most important are 1, 4, and 5.",
            practice: "Five minutes a day for a week. Play 1–4–5–1 in G, D, and A. Say the numbers out loud as you change chords.",
            steps: [
                Learn(
                    title: "Chord families",
                    explain: "Chords live in families called keys. Every family has a leader, the 1 chord, which feels like home. Two best friends always come along: the 4 chord and the 5 chord. The 5 chord really wants to lead you back home. Thousands of songs use just 1, 4, and 5!",
                    facts: [
                        "Count up the letters from the key's name. In G: G is 1, A is 2, B is 3, C is 4, D is 5.",
                        "Key of G: G, C, D. Key of D: D, G, A. Key of A: A, D, E.",
                        "The family also has a minor 6 chord. In G it's E minor.",
                    ],
                    visual: Some(NumberWheel(key: "G")),
                ),
                Learn(
                    title: "The key of D",
                    explain: "Same pattern, new family. Click each chord to hear it.",
                    visual: Some(NumberWheel(key: "D")),
                ),
                Learn(
                    title: "The family tree of a key",
                    explain: "Each key has a family of chords. Give them numbers by counting up the scale. In the key of G, G is 1, C is 4, and D is 5. These three chords are the most important ones in the family. Thousands of songs use just these three!",
                    facts: [
                        "Key of G: 1 = G, 4 = C, 5 = D.",
                        "Key of D: 1 = D, 4 = G, 5 = A.",
                    ],
                    tips: [
                        "Don't memorize every key at once. Learn G, D, and A first, since they use chords you already know.",
                    ],
                    visual: Some(NumberWheel(key: "G")),
                ),
                Activity(
                    title: "1–4–5–1 in G",
                    instructions: "G, C, D7, G.",
                    activity: StrumAlong(chords: ["G", "C", "D7", "G"], beats_per_chord: 4, pattern: OldFaithful, tempos: [70.0, 80.0], repeats: 2),
                ),
                Activity(
                    title: "1–4–5–1 in A",
                    instructions: "A, D, E7, A.",
                    activity: StrumAlong(chords: ["A", "D", "E7", "A"], beats_per_chord: 4, pattern: OldFaithful, tempos: [70.0, 80.0], repeats: 2),
                ),
                Check(
                    pass_percent: 75,
                    questions: [
                        (
                            prompt: "In the key of D, what is the 5 chord?",
                            choices: ["A", "G", "E"],
                            answer: 0,
                            explain: "Count up the D major scale: D (1), E (2), F♯ (3), G (4), A (5). So the 5 chord is A.",
                        ),
                        (
                            prompt: "In the key of A, what is the 4 chord?",
                            choices: ["D", "E", "B"],
                            answer: 0,
                            explain: "Count up the A major scale: A (1), B (2), C♯ (3), D (4). So the 4 chord is D.",
                        ),
                        (
                            prompt: "Which chord feels like home?",
                            choices: ["The 1 chord", "The 5 chord", "The 4 chord"],
                            answer: 0,
                            explain: "The 1 chord is the key's home base. Songs usually start and end there.",
                        ),
                        (
                            prompt: "In the key of G, what is the minor 6 chord?",
                            choices: ["E minor", "A minor", "D minor"],
                            answer: 0,
                            explain: "Count up G major: G A B C D E. The 6th note is E, and the 6 chord in a major key is minor: E minor.",
                        ),
                    ],
                ),
            ],
        ),
        Lesson(
            id: "L3.12",
            title: "Ear Lab: Hearing Chord Changes",
            thread: TheoryEar,
            minutes: 10,
            prerequisites: ["L3.11"],
            goal: "Hear when a chord changes, and whether it moved to 4 or 5.",
            practice: "Two minutes a day: play the 4 or 5 game in the Ear Gym. Then try to hear the chord changes in a song you like.",
            steps: [
                Learn(
                    title: "Follow the bass",
                    explain: "Listen to the bass, the lowest sound. When it moves, the chord usually changed. Going to 5 sounds like uh-oh, we need to go home. Going to 4 sounds like let's take a little trip.",
                    facts: [
                        "Count bars out loud while you listen: 1-2-3-4, 2-2-3-4…",
                        "Songs have parts: intro, verse, chorus, bridge, and outro.",
                    ],
                    visual: Some(NumberWheel(key: "G")),
                    tips: [
                        "Hum the lowest note you hear. When your hum has to move, the chord changed.",
                    ],
                ),
                Learn(
                    title: "The bass tells the story",
                    explain: "When the chord changes, the lowest note usually changes too. Listen to the bass, not the whole chord. In the key of G, the bass goes up a little for the 4 chord (C) and up more for the 5 chord (D). The 5 chord also sounds like it wants to go home.",
                    facts: [
                        "1 to 4: a small, gentle step.",
                        "1 to 5: a bigger step that leans back toward home.",
                    ],
                    visual: Some(ChordPair("C", "D")),
                ),
                Activity(
                    title: "4 or 5?",
                    instructions: "After G, did the music go to the 4 chord or the 5 chord?",
                    activity: EarQuiz(kind: FourOrFive, rounds: 8),
                ),
                Check(
                    pass_percent: 66,
                    questions: [
