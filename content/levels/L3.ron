                            choices: ["4", "5"],
                            answer: 1,
                            explain: "It went to D, the 5 chord in G.",
                        ),
                        (
                            prompt: "Listen: G, then… Did it go to 4 or 5?",
                            audio: Some(Chords(["G", "C"])),
                            choices: ["4", "5"],
                            answer: 0,
                            explain: "It went to C, the 4 chord in G.",
                        ),
                        (
                            prompt: "Which part of a song usually repeats the same words each time?",
                            choices: ["The chorus", "The verse", "The intro"],
                            answer: 0,
                            explain: "The chorus is the catchy part that comes back with the same words. Verses usually change the words each time.",
                        ),
                    ],
                ),
            ],
        ),
