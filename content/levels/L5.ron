// Level 5 — Lead Guitar Basics. See docs/02-Curriculum-Part3-Levels-5-6.md.
Level(
    number: 5,
    title: "Lead Guitar Basics",
    goal: "The minor pentatonic, hammer-ons, pull-offs, slides, bends, vibrato, the 12-bar blues, and your first solo.",
    weeks: "6–8 weeks",
    lessons: [
        Lesson(
            id: "L5.1",
            title: "The Minor Pentatonic Scale: Box 1",
            thread: Notes,
            minutes: 20,
            prerequisites: ["L4.13"],
            goal: "Play the A minor pentatonic Box 1 up and down, and know where its roots are.",
            practice: "Five minutes a day for a week. Climb the box up and down with alternate picking. Start slow with the metronome at 60, then go up by 5 each day.",
            steps: [
                Learn(
                    title: "A five-note ladder",
                    explain: "\"Penta\" means five. This scale is a ladder with five notes. It is the scale behind most rock and blues solos. It skips the two notes that are easy to bump into wrong. So almost anything you play from it sounds good! Its shape looks like a box, with two notes on every string.",
                    facts: [
                        "The recipe: 1, ♭3, 4, 5, ♭7. In A that's A C D E G.",
                        "Finger 1 plays every fret-5 note. Fingers 3 and 4 play frets 7 and 8.",
                        "Red squares are roots (A). There are three of them in the box.",
                    ],
                    visual: Some(ScaleBox(root: "A", scale: "minor_pentatonic", shape: Some(1), first_fret: 3, last_fret: 10)),
                ),
                Learn(
                    title: "Up the ladder",
                    explain: "Start on the low A at string 6, fret 5. Play two notes on each string, then move to the next string. When you reach the top, come back down. Pick down, up, down, up the whole way.",
                    visual: Some(Tab([
                        (string: 6, fret: 5), (string: 6, fret: 8), (string: 5, fret: 5), (string: 5, fret: 7),
                        (string: 4, fret: 5), (string: 4, fret: 7), (string: 3, fret: 5), (string: 3, fret: 7),
                        (string: 2, fret: 5), (string: 2, fret: 8), (string: 1, fret: 5), (string: 1, fret: 8, beats: 2.0),
                    ])),
                ),
                Learn(
                    title: "Two notes on every string",
                    explain: "Box 1 has exactly two notes on each string. Use finger 1 for the lower fret and finger 3 or 4 for the higher one. On strings 6, 1, and 2 the gap is three frets, so use finger 4. On strings 5, 4, and 3 the gap is two frets, so use finger 3.",
                    facts: [
                        "Root notes (A) are on string 6 fret 5, string 4 fret 7, and string 1 fret 5.",
                        "Start and end on a root so it sounds finished.",
                    ],
                    tips: [
                        "Keep finger 1 parked at fret 5. Don't let your hand slide around.",
                        "Pick down, up, down, up. That's called alternate picking.",
                    ],
                    visual: Some(Neck(notes: [(string: 6, fret: 5), (string: 4, fret: 7), (string: 1, fret: 5)], first_fret: 3, last_fret: 10, show_names: true)),
                ),
                Activity(
                    title: "Climb the box",
                    instructions: "Play Box 1 from the bottom to the top. Go slow and let each note ring.",
                    activity: PlayNotes(tempo: 60.0, notes: [
                        (string: 6, fret: 5), (string: 6, fret: 8), (string: 5, fret: 5), (string: 5, fret: 7),
                        (string: 4, fret: 5), (string: 4, fret: 7), (string: 3, fret: 5), (string: 3, fret: 7),
                        (string: 2, fret: 5), (string: 2, fret: 8), (string: 1, fret: 5), (string: 1, fret: 8, beats: 2.0),
                    ]),
                ),
                Activity(
                    title: "Climb back down",
                    instructions: "Now from the top back to the low A.",
                    activity: PlayNotes(tempo: 60.0, notes: [
                        (string: 1, fret: 8), (string: 1, fret: 5), (string: 2, fret: 8), (string: 2, fret: 5),
                        (string: 3, fret: 7), (string: 3, fret: 5), (string: 4, fret: 7), (string: 4, fret: 5),
                        (string: 5, fret: 7), (string: 5, fret: 5), (string: 6, fret: 8), (string: 6, fret: 5, beats: 2.0),
                    ]),
                ),
                Check(
                    pass_percent: 75,
                    questions: [
                        (
                            prompt: "Which notes are in A minor pentatonic?",
                            choices: ["A C D E G", "A B C D E F G", "A C E"],
                            answer: 0,
                            explain: "The recipe 1, ♭3, 4, 5, ♭7 from A gives A, C, D, E, G. Five notes, so it's a pentatonic (\"five-note\") scale.",
                        ),
                        (
                            prompt: "How many notes does the box have on each string?",
                            choices: ["Two", "Three", "One"],
                            answer: 0,
                            explain: "Every string in Box 1 has two notes, which is why it looks like a neat box.",
                        ),
                        (
                            prompt: "In Box 1, which finger plays all the fret-5 notes?",
                            choices: ["Finger 1", "Finger 3", "Finger 4"],
                            answer: 0,
                            explain: "Box 1 sits with finger 1 at fret 5. Finger 1 plays every fret-5 note, and fingers 3 and 4 reach frets 7 and 8.",
                        ),
                        (
                            prompt: "Move Box 1 so its root on string 6 is at fret 8. What scale is it now?",
                            choices: ["C minor pentatonic", "A minor pentatonic", "G minor pentatonic"],
                            answer: 0,
                            explain: "The root on string 6 names the scale. String 6, fret 8 is C.",
                        ),
                    ],
                ),
            ],
        ),
        Lesson(
            id: "L5.2",
            title: "Pentatonic Licks and Patterns",
            thread: Notes,
            minutes: 15,
            prerequisites: ["L5.1"],
            goal: "Learn three short licks in Box 1 and use them over a backing groove.",
            practice: "Five minutes a day for a week. Play each lick four times, then make up a new lick that ends on an A.",
            steps: [
                Learn(
                    title: "Licks are words",
                    explain: "A scale is like the alphabet. A lick is like a word. Learn a few words and you can make sentences. That is what a solo is! Great players keep a bag of short licks and mix them up. Each lick here ends on a root, so it sounds finished.",
                    facts: [
                        "Lick 1 walks down strings 2, 3, and 4 and lands on A.",
                        "Lick 2 plays the box in groups of three notes.",
                        "Lick 3 runs down from the top and lands on A.",
                    ],
                    visual: Some(Tab([
                        (string: 2, fret: 5), (string: 2, fret: 8), (string: 2, fret: 5), (string: 3, fret: 7),
                        (string: 3, fret: 5), (string: 4, fret: 7, beats: 3.0),
                    ])),
                ),
                Learn(
                    title: "Question and answer",
                    explain: "Good solos sound like talking. Play a short lick that ends on a note that is not A. That sounds like a question. Then play a lick that ends on A. That sounds like an answer. Try it: ask, then answer.",
                    facts: [
                        "Ending on the root (A) sounds finished.",
                        "Ending on other notes sounds like there's more to say.",
                    ],
                    tips: [
                        "Leave a little space between licks. Silence is part of music too.",
                    ],
                    visual: Some(Tab([(string: 2, fret: 5), (string: 2, fret: 8), (string: 1, fret: 5), (string: 1, fret: 8, beats: 2.0), (string: 2, fret: 8), (string: 2, fret: 5), (string: 3, fret: 7), (string: 3, fret: 5), (string: 4, fret: 7, beats: 2.0)])),
                ),
                Activity(
                    title: "Lick 1: land on A",
                    instructions: "Play lick 1. Hold the last note.",
                    activity: PlayNotes(tempo: 70.0, notes: [
                        (string: 2, fret: 5), (string: 2, fret: 8), (string: 2, fret: 5), (string: 3, fret: 7),
                        (string: 3, fret: 5), (string: 4, fret: 7, beats: 3.0),
                    ]),
                ),
                Activity(
                    title: "Lick 2: groups of three",
                    instructions: "Three notes, then start one note higher. Say \"1-2-3, 2-3-4\" as you go.",
                    activity: PlayNotes(tempo: 70.0, notes: [
                        (string: 6, fret: 5), (string: 6, fret: 8), (string: 5, fret: 5),
                        (string: 6, fret: 8), (string: 5, fret: 5), (string: 5, fret: 7),
                        (string: 5, fret: 5), (string: 5, fret: 7), (string: 4, fret: 5),
                        (string: 5, fret: 7), (string: 4, fret: 5), (string: 4, fret: 7, beats: 3.0),
                    ]),
                ),
                Activity(
                    title: "Lick 3: the waterfall",
                    instructions: "Start at the top and run down to the A on string 4.",
                    activity: PlayNotes(tempo: 70.0, notes: [
                        (string: 1, fret: 8), (string: 1, fret: 5), (string: 2, fret: 8), (string: 2, fret: 5),
                        (string: 3, fret: 7), (string: 3, fret: 5), (string: 4, fret: 7, beats: 2.0),
                    ]),
                ),
                Activity(
                    title: "Jam with your licks",
                    instructions: "Start the backing. Play a lick, rest, then play another. The neck lights up the notes you play.",
                    activity: Jam(key: "A", scale: "minor_pentatonic", shape: Some(1), chords: ["Am", "Dm", "Am", "Em"], pattern: Eighths, bpm: 80.0),
                ),
                Check(
                    pass_percent: 66,
                    questions: [
                        (
                            prompt: "A scale is like the alphabet. A lick is like…",
                            choices: ["A word", "A whole book", "A single letter"],
                            answer: 0,
                            explain: "Notes are like letters and a lick is like a word: a short idea you can put into sentences (solos).",
                        ),
                        (
                            prompt: "Why do these licks end on A?",
                            choices: ["A is the root, so the lick sounds finished", "A is the highest note", "A is the easiest note to bend"],
                            answer: 0,
                            explain: "A is the root, the home note of A minor pentatonic. Ending on it makes a lick sound finished.",
                        ),
                        (
                            prompt: "What comes after \"1-2-3\" in groups of three?",
                            choices: ["2-3-4", "4-5-6", "3-2-1"],
                            answer: 0,
                            explain: "In groups of three, each group starts one note higher than the last: 1-2-3, then 2-3-4, then 3-4-5.",
                        ),
                    ],
                ),
            ],
        ),
        Lesson(
            id: "L5.3",
            title: "The 12-Bar Blues",
            thread: Chords,
            minutes: 15,
            prerequisites: ["L5.2"],
            goal: "Know the 12-bar blues map and strum it in E and A.",
            practice: "Five minutes a day for a week. Play the 12 bars in E and in A, counting the bars out loud. Then play it without counting.",
            steps: [
                Learn(
                    title: "A 12-bar song map",
                    explain: "The 12-bar blues is a song map. It is 12 bars long and uses just three chords: the 1, the 4, and the 5. Learn this map and you can jam with almost anyone. Tons of blues and rock songs use it. One time through all 12 bars is called a chorus.",
                    facts: [
                        "Row 1: 1 1 1 1. Row 2: 4 4 1 1. Row 3: 5 4 1 5.",
                        "The last bar is the turnaround. It points you back to the top.",
                        "Orange = the 1 chord, green = the 4, blue = the 5.",
                    ],
                    visual: Some(TwelveBar(key: "A")),
                ),
                Learn(
                    title: "Bluesy 7th chords",
                    explain: "In the blues, all three chords are usually 7th chords. They sound a little spicy. In the key of A, play A7, D7, and E7. In the key of E, play E7, A7, and B7. You learned these shapes back in Level 3.",
                    visual: Some(TwelveBar(key: "E")),
                ),
                Learn(
                    title: "The turnaround",
                    explain: "Bars 11 and 12 are called the turnaround. In bar 12, the 5 chord pulls you back to the start. It sounds like a door swinging open. When you hear it, you know a new round of 12 bars is coming.",
                    facts: [
                        "Bar 9 is the 5 chord, bar 10 is the 4 chord.",
                        "Bar 12 is the 5 chord, ready to go home.",
                    ],
                    tips: [
                        "Lost your place? Listen for the 4 chord in bar 5. It always changes there.",
                    ],
                    visual: Some(ChordPair("E7", "B7")),
                ),
                Activity(
                    title: "12 bars in E",
                    instructions: "Strum once per beat. Follow the chord names. Count the bars!",
                    activity: StrumAlong(chords: ["E7", "E7", "E7", "E7", "A7", "A7", "E7", "E7", "B7", "A7", "E7", "B7"], beats_per_chord: 4, pattern: Quarters, tempos: [70.0, 90.0], repeats: 1),
                ),
                Activity(
                    title: "12 bars in A",
                    instructions: "Same map, new key.",
                    activity: StrumAlong(chords: ["A7", "A7", "A7", "A7", "D7", "D7", "A7", "A7", "E7", "D7", "A7", "E7"], beats_per_chord: 4, pattern: Quarters, tempos: [70.0, 90.0], repeats: 1),
                ),
                Check(
                    pass_percent: 75,
                    questions: [
                        (
                            prompt: "How many bars long is one time through the blues?",
                            choices: ["12", "8", "16"],
                            answer: 0,
                            explain: "One chorus of the blues is 12 bars long. That's where the name \"12-bar blues\" comes from.",
                        ),
                        (
                            prompt: "Which chord numbers does the 12-bar blues use?",
                            choices: ["1, 4, and 5", "1, 2, and 3", "1, 5, and 6"],
                            answer: 0,
                            explain: "The 12-bar blues uses only three chords: the 1, the 4, and the 5.",
                        ),
                        (
                            prompt: "Which chord is in bar 9?",
                            choices: ["The 5 chord", "The 1 chord", "The 4 chord"],
                            answer: 0,
                            explain: "Row 3 starts with the 5 chord in bar 9, then the 4, the 1, and the 5 again.",
                        ),
                        (
                            prompt: "In the key of A, what is the 4 chord?",
                            choices: ["D7", "E7", "B7"],
                            answer: 0,
                            explain: "Count up from A: A (1), B (2), C♯ (3), D (4). Blues uses 7th chords, so the 4 chord is D7.",
                        ),
                        (
                            prompt: "What is the turnaround?",
                            choices: ["The last bar, which leads back to the top", "The first bar", "A strum pattern"],
                            answer: 0,
                            explain: "The turnaround is the end of the chorus (usually the 5 chord in bar 12). It points the music back to the top.",
                        ),
                    ],
                ),
            ],
        ),
        Lesson(
            id: "L5.4",
            title: "Shuffle Feel and the Boogie Riff",
            thread: Rhythm,
            minutes: 15,
            prerequisites: ["L5.3"],
            goal: "Play eighth notes with a long-short shuffle, and play the boogie riff over the 12-bar blues.",
            practice: "Five minutes a day for a week. Play the boogie riff on A, D, and E with a swing feel. Then play it all the way through the 12-bar blues.",
            steps: [
                Learn(
                    title: "Long-short, long-short",
                    explain: "In a shuffle, the eighth notes are not even. They go long-short, long-short. It sounds like a horse galloping. Say \"HUMP-ty DUMP-ty\" and you've got it. Count \"1-trip-let, 2-trip-let.\" Play on the \"1\" and on the \"let.\"",
                    facts: [
                        "Even eighths are called straight. Long-short eighths are called swung.",
                        "The first note gets about two thirds of the beat.",
                    ],
                    visual: Some(StrumGrid(Swing8)),
                ),
                Activity(
                    title: "Straight or swing?",
                    instructions: "Listen. Are the notes even, or long-short?",
                    activity: EarQuiz(kind: StraightOrSwing, rounds: 6),
                ),
                Learn(
                    title: "The boogie riff",
                    explain: "Here is a famous blues riff. Play the open A string plus string 4, fret 2. Then reach your pinky to string 4, fret 4. Rock back and forth: two of the first, two of the second. Rest your picking hand lightly on the strings to get a chunky sound.",
                    facts: [
                        "The first pair is the root and the 5th. The second is the root and the 6th.",
                        "For D, use strings 4 and 3. For E, use strings 6 and 5.",
                        "Swing it! Long-short, long-short.",
                    ],
                    visual: Some(StrumGrid(Boogie)),
                ),
                Learn(
                    title: "The boogie riff up close",
                    explain: "The boogie riff uses two strings. The open string is the root. On the next string, play fret 2, then fret 4, then back to 2. Your finger 1 stays at fret 2 while finger 3 reaches for fret 4.",
                    facts: [
                        "A: open string 5 with string 4.",
                        "D: open string 4 with string 3. E: open string 6 with string 5.",
                    ],
                    tips: [
                        "Swing it! Long-short, long-short. Say \"hump-ty dump-ty\" as you play.",
                    ],
                    visual: Some(Tab([(string: 5, fret: 0), (string: 4, fret: 2), (string: 5, fret: 0), (string: 4, fret: 2), (string: 5, fret: 0), (string: 4, fret: 4), (string: 5, fret: 0), (string: 4, fret: 4)])),
                ),
                Activity(
                    title: "Boogie through the 12 bars",
                    instructions: "Play the boogie riff on each chord. The app plays the riff on the chord's root.",
                    activity: StrumAlong(chords: ["A7", "A7", "A7", "A7", "D7", "D7", "A7", "A7", "E7", "D7", "A7", "E7"], beats_per_chord: 4, pattern: Boogie, tempos: [70.0, 90.0], repeats: 1),
                ),
                Check(
                    pass_percent: 75,
                    questions: [
                        (
                            prompt: "In a shuffle, how do the eighth notes feel?",
                            choices: ["Long-short, long-short", "Even, like a clock", "Short-long, short-long"],
                            answer: 0,
                            explain: "A shuffle swings the eighth notes: long-short, long-short, like a galloping horse.",
                        ),
                        (
                            prompt: "In \"1-trip-let,\" which parts do you play?",
                            choices: ["The \"1\" and the \"let\"", "The \"trip\" only", "All three"],
                            answer: 0,
                            explain: "Split each beat into three (1-trip-let) and play only the first and last parts. That gives the long-short swing.",
                        ),
                        (
                            prompt: "The boogie riff rocks between the 5th and which other note?",
                            choices: ["The 6th", "The 3rd", "The 2nd"],
                            answer: 0,
                            explain: "The riff rocks between root + 5th and root + 6th. The pinky reaches two frets up to make the 6th.",
                        ),
                        (
                            prompt: "Which strings play the boogie riff on the A chord?",
                            choices: ["Strings 5 and 4", "Strings 6 and 5", "Strings 2 and 1"],
                            answer: 0,
                            explain: "For A, the open A string is the root, and string 4 adds the 5th (fret 2) or the 6th (fret 4).",
                        ),
                    ],
                ),
            ],
        ),
        Lesson(
            id: "L5.5",
            title: "Hammer-Ons and Pull-Offs",
            thread: Technique,
            minutes: 15,
            prerequisites: ["L5.4"],
            goal: "Make two notes from one pick with hammer-ons and pull-offs.",
            practice: "Five minutes a day for a week. Play each hammer-on and pull-off ten times. Try to make the second note as loud as the first.",
            steps: [
                Learn(
                    title: "Hammer it on",
                    explain: "Pick one note. Then slam another finger down, like a tiny hammer. You get a second note, and you didn't pick again! Hit close to the fret with your fingertip. In tab, a hammer-on is an \"h\" between the notes.",
                    facts: [
                        "Tab: 5h7 means pick fret 5, then hammer on fret 7.",
                        "Hammer fast and firm. A soft hammer makes a weak note.",
                    ],
                    visual: Some(Tab([(string: 3, fret: 5), (string: 3, fret: 7, tech: Some(Hammer)), (string: 2, fret: 5), (string: 2, fret: 8, tech: Some(Hammer), beats: 2.0)])),
                    tips: [
                        "Come down on the tip of your finger, right behind the fret.",
                        "Fast and firm, like tapping a drum.",
                    ],
                ),
                Learn(
                    title: "Pull it off",
                    explain: "A pull-off is the other way around. Put both fingers down. Pick the higher note. Then flick the top finger off the string, a little toward the floor. The lower note rings out. Don't just lift! The flick plucks the string. In tab, a pull-off is a \"p.\"",
                    facts: [
                        "The lower finger must already be down before you pull off.",
                        "Hammer-ons and pull-offs together are called legato. It means smooth.",
                    ],
                    visual: Some(Tab([(string: 2, fret: 8), (string: 2, fret: 5, tech: Some(Pull)), (string: 3, fret: 7), (string: 3, fret: 5, tech: Some(Pull), beats: 2.0)])),
                    tips: [
                        "Keep the lower finger already pressed down before you pull.",
                        "Pull a little sideways, like plucking with your fretting finger.",
                    ],
                ),
                Activity(
                    title: "Hammer up the box",
                    instructions: "Pick the first note on each string, then hammer the second. The mic listens for both notes.",
                    activity: PlayNotes(tempo: 60.0, notes: [
                        (string: 4, fret: 5), (string: 4, fret: 7, tech: Some(Hammer)),
                        (string: 3, fret: 5), (string: 3, fret: 7, tech: Some(Hammer)),
                        (string: 2, fret: 5), (string: 2, fret: 8, tech: Some(Hammer)),
                        (string: 1, fret: 5), (string: 1, fret: 8, tech: Some(Hammer), beats: 2.0),
                    ]),
                ),
                Activity(
                    title: "Pull down the box",
                    instructions: "Pick the high note, then pull off to the low one.",
                    activity: PlayNotes(tempo: 60.0, notes: [
                        (string: 1, fret: 8), (string: 1, fret: 5, tech: Some(Pull)),
                        (string: 2, fret: 8), (string: 2, fret: 5, tech: Some(Pull)),
                        (string: 3, fret: 7), (string: 3, fret: 5, tech: Some(Pull)),
                        (string: 4, fret: 7, beats: 2.0),
                    ]),
                ),
                Check(
                    pass_percent: 75,
                    questions: [
                        (
                            prompt: "What does 5h7 mean in tab?",
                            choices: ["Pick fret 5, then hammer on fret 7", "Pick fret 7, then pull off to fret 5", "Slide from 5 to 7"],
                            answer: 0,
                            explain: "The \"h\" means hammer-on: pick fret 5, then slam another finger onto fret 7 without picking again.",
                        ),
                        (
                            prompt: "How do you do a pull-off?",
                            choices: ["Flick the finger off the string so the lower note rings", "Lift the finger straight up", "Pick both notes"],
                            answer: 0,
                            explain: "Pull the finger off a little sideways, toward the floor. That flick plucks the string so the lower note sounds.",
                        ),
                        (
                            prompt: "Before a pull-off, where is the lower finger?",
                            choices: ["Already pressing its fret", "In the air", "On the next string"],
                            answer: 0,
                            explain: "The lower note's finger must already be pressing. When the top finger flicks off, that note is ready to ring.",
                        ),
                        (
                            prompt: "What does \"legato\" mean?",
                            choices: ["Smooth", "Loud", "Fast"],
                            answer: 0,
                            explain: "Legato means smooth and connected. Hammer-ons and pull-offs let notes flow without new picks.",
                        ),
                    ],
                ),
            ],
        ),
        Lesson(
            id: "L5.6",
            title: "Slides",
            thread: Technique,
            minutes: 10,
            prerequisites: ["L5.5"],
            goal: "Slide between notes and keep them ringing.",
            practice: "Five minutes a day for five days. Play both slide licks slowly. Listen for a smooth sound with no gap in the middle.",
            steps: [
                Learn(
                    title: "Glide like a sled",
                    explain: "Keep your finger pressed down and glide it along the string, like a sled on snow. The sound slides with you. Don't let up! If you press too lightly, the note dies. In tab, a slash means slide: 5/7 slides up, 7\\5 slides down.",
                    facts: [
                        "Pick once, at the start. The slide does the rest.",
                        "Blues players love to slide into a note from one or two frets below.",
                        "Slides will help you move between boxes later.",
                    ],
                    visual: Some(Tab([(string: 3, fret: 5), (string: 3, fret: 7, tech: Some(Slide)), (string: 2, fret: 5), (string: 2, fret: 8, beats: 2.0)])),
                    tips: [
                        "Keep pressing as you slide. If you let go, the sound stops.",
                        "Press a little lighter than usual so your finger can glide.",
                    ],
                ),
                Learn(
                    title: "Slide into a note",
                    explain: "You can also slide in from nowhere. Start two or three frets below your note, and press lightly. Pick, then slide up and land on the note. You don't hear the starting fret clearly. It just sounds like a swoop into the note.",
                    facts: [
                        "A slide up sounds exciting. A slide down sounds relaxed.",
                        "In tab, a slide is shown with a slash: / for up, \\ for down.",
                    ],
                    tips: [
                        "Stop exactly on the target fret. Going past it sounds sloppy.",
                    ],
                    visual: Some(Tab([(string: 3, fret: 4), (string: 3, fret: 7, tech: Some(Slide), beats: 2.0), (string: 2, fret: 5), (string: 2, fret: 8, beats: 2.0)])),
                ),
                Activity(
                    title: "Slide lick 1",
                    instructions: "Pick, slide up, then finish on string 2.",
                    activity: PlayNotes(tempo: 60.0, notes: [
                        (string: 3, fret: 5), (string: 3, fret: 7, tech: Some(Slide)), (string: 2, fret: 5), (string: 2, fret: 8), (string: 1, fret: 5, beats: 2.0),
                    ]),
                ),
                Activity(
                    title: "Slide lick 2",
                    instructions: "Slide up, then slide back down.",
                    activity: PlayNotes(tempo: 60.0, notes: [
