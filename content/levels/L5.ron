        Lesson(
            id: "L5.8",
            title: "Vibrato",
            thread: Technique,
            minutes: 10,
            prerequisites: ["L5.7"],
            goal: "Hold a note with a steady, even vibrato.",
            practice: "Three minutes a day for a week. Hold a note for four beats with vibrato. Try slow, wide wobbles and then fast, small ones.",
            steps: [
                Learn(
                    title: "Make the note shimmer",
                    explain: "Vibrato is a little wobble on a note. Think of a singer's voice shaking at the end of a long note. It makes a note sound alive instead of flat. To do it, bend the string up a tiny bit, let it back down, and repeat. Turn your wrist like a doorknob.",
                    facts: [
                        "Steady speed matters more than how wide you wobble.",
                        "Try about five wobbles each second.",
                        "In tab, vibrato is a wavy line: ~",
                    ],
                    visual: Some(Tab([(string: 3, fret: 5), (string: 3, fret: 7), (string: 4, fret: 7, tech: Some(Vibrato), beats: 4.0)])),
                    tips: [
                        "Keep the wobble steady, like a rocking chair. Uneven vibrato sounds shaky.",
                        "Move from your wrist, not your fingertip.",
                    ],
                ),
                Learn(
                    title: "Two kinds of vibrato",
                    explain: "There are two ways to wobble a note. Bend vibrato pushes the string up and down, a tiny bit, over and over. Classical vibrato rocks your finger left and right along the string. Rock and blues players mostly use bend vibrato.",
                    facts: [
                        "Bend vibrato: up and down, across the neck.",
                        "Classical vibrato: side to side, along the neck.",
                    ],
                    tips: [
                        "Add vibrato at the end of a long note. That's where it sounds best.",
                    ],
                    visual: Some(Neck(notes: [(string: 3, fret: 7), (string: 2, fret: 8), (string: 1, fret: 5)], first_fret: 4, last_fret: 10, show_names: true)),
