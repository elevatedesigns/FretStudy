                Activity(
                    title: "Steady wobble",
                    instructions: "Hold the A on string 4, fret 7, and add vibrato. The wavy line shows your wobble.",
                    activity: VibratoCheck(string: 4, fret: 7),
                ),
                Activity(
                    title: "Vibrato on a bend",
                    instructions: "Try it on string 2, fret 8, too.",
                    activity: VibratoCheck(string: 2, fret: 8),
                ),
